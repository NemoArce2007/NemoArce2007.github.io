---
import { SITE } from '../lib/site';

interface Props {
	current?: 'home' | 'posts' | 'about' | 'post';
}

const { current = 'home' } = Astro.props;
---

<header class="site-header">
	<div class="shell">
		<a class="site-title" href="/">{SITE.title}</a>
		<nav class="nav" aria-label="主导航">
			<a href="/posts" aria-current={current === 'posts' || current === 'post' ? 'page' : undefined}>文章</a>
			<a href="/about" aria-current={current === 'about' ? 'page' : undefined}>关于</a>
		</nav>
	</div>
</header>
